# Copy to .env.production and replace every required placeholder locally.
# Never commit .env.production.
ROOTSIGNAL_BASE_PATH=/project/rootsignalbench
SITE_URL=https://www.medhaveeupadhyaya.com/project/rootsignalbench
ROOTSIGNAL_WEB_BIND=127.0.0.1
ROOTSIGNAL_WEB_PORT=3000
ROOTSIGNAL_RATE_LIMIT=30
ROOTSIGNAL_RATE_WINDOW_SECONDS=60

ROOTSIGNAL_API_KEY=<generate-a-random-value>
INCIDENTLAB_LLM_URL=<openai-compatible-base-url>
INCIDENTLAB_MODEL=<provider-model-id>
INCIDENTLAB_LLM_API_KEY=
